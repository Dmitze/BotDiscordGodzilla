{
  "name": "discord-google-bot",
  "version": "2.3.0",
  "description": "Discord AI Assistant Bot з інтеграцією Google Sheets, Google Drive та AI-функціоналом",
  "main": "dist/index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register src/index.ts\"",
    "dev:ts": "ts-node index.ts",
    "build": "tsc",
    "postbuild": "tsc-alias",
    "build:watch": "tsc --watch",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "prebuild": "npm run clean",
    "deploy": "npm run build && node build/scripts/deploy-production.js",
    "deploy:global": "npm run build && node build/scripts/deploy-production.js global",
    "deploy:guild": "npm run build && node build/scripts/deploy-production.js guild",
    "delete-commands": "node build/scripts/deploy-production.js delete",
    "status-commands": "node build/scripts/deploy-production.js status",
    "lint": "eslint src/**/*.{js,ts}",
    "lint:fix": "eslint src/**/*.{js,ts} --fix",
    "format": "prettier --write src/**/*.{js,ts}",
    "format:check": "prettier --check src/**/*.{js,ts}",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=src/tests/unit",
    "test:integration": "jest --testPathPattern=src/tests/integration",
    "test:e2e": "jest --testPathPattern=src/tests/e2e",
    "test:performance": "jest --testPathPattern=src/tests/performance",
    "test:load": "jest --testPathPattern=src/tests/load",
    "test:commands": "jest --testPathPattern=src/tests/unit/commands",
    "test:services": "jest --testPathPattern=src/tests/unit/services",
    "test:utils": "jest --testPathPattern=src/tests/unit/utils",
    "test:coverage:html": "jest --coverage --coverageReporters=html",
    "test:coverage:json": "jest --coverage --coverageReporters=json",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance && npm run test:load",
    "prepare": "husky install",
    "docker:build": "docker build -t discord-ai-bot .",
    "docker:run": "docker run -d --name discord-ai-bot discord-ai-bot",
    "docker:compose": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "deploy:setup": "chmod +x build/scripts/deploy.sh && ./build/scripts/deploy.sh",
    "deploy:dev": "chmod +x build/scripts/deploy.sh && ./build/scripts/deploy.sh --dev",
    "deploy:test": "chmod +x build/scripts/deploy.sh && ./build/scripts/deploy.sh --test",
    "deploy:pm2": "chmod +x build/scripts/deploy.sh && ./build/scripts/deploy.sh --pm2",
    "deploy:docker": "chmod +x build/scripts/deploy.sh && ./build/scripts/deploy.sh --docker",
    "start:dev": "node build/scripts/start.js --dev",
    "start:test": "node build/scripts/start.js --test",
    "start:pm2": "node build/scripts/start.js --pm2",
    "start:docker": "node build/scripts/start.js --docker",
    "setup": "npm run deploy:setup && npm run deploy:guild",
    "setup:dev": "npm run deploy:dev && npm run deploy:guild",
    "setup:prod": "npm run deploy:pm2 && npm run deploy:guild",
    "deploy:commands": "ts-node src/scripts/deployCommands.ts",
    "deploy:commands:build": "npm run build && node dist/scripts/deployCommands.js"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "google-sheets",
    "google-drive",
    "nlp",
    "automation",
    "openai",
    "ollama",
    "redis",
    "prometheus"
  ],
  "author": "Dmitze",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dmitze/BotDiscordGodzilla.git"
  },
  "bugs": {
    "url": "https://github.com/Dmitze/BotDiscordGodzilla/issues"
  },
  "homepage": "https://github.com/Dmitze/BotDiscordGodzilla#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@discordjs/builders": "^1.11.2",
    "@discordjs/rest": "^2.5.0",
    "@google-cloud/vision": "^5.3.3",
    "buffer": "^6.0.3",
    "crypto": "^1.0.1",
    "discord-api-types": "^0.38.11",
    "discord.js": "^14.19.3",
    "docx": "^8.5.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^107.0.0",
    "mammoth": "^1.10.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.104.0",
    "path": "^0.12.7",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.14.0",
    "prom-client": "^15.1.0",
    "redis": "^4.6.13",
    "stream": "^0.0.2",
    "tesseract.js": "^6.0.1",
    "url": "^0.11.3",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.3"
  }
}
