# Discord Google Bot — example environment configuration
# Copy this file to .env and fill values. Comments show defaults where applicable.

# === Core Discord ===
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional for global slash-commands; required for guild-scoped deploys
DISCORD_GUILD_ID=
DISCORD_PREFIX=! 
# Comma-separated intents; MessageContent will be controlled by flag below
DISCORD_INTENTS=Guilds,GuildMessages
# Feature flags
ENABLE_CHAT=true
ENABLE_SLASH=false
ENABLE_MESSAGE_CONTENT_INTENT=true

# === Google ===
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_API_KEY=
# Path to service account JSON file (absolute or relative). If blank, will try per-variable creds
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative per-variable credentials (override file if present)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=
# Apps Script endpoint (used by some features)
GOOGLE_APP_SCRIPT_URL=

# OCR (offline-friendly defaults)
OCR_PROVIDER=off # vision|tesseract|off
OCR_CACHE_TTL=3600
TESSERACT_LANGS=eng
TESSERACT_LANG_PATH=

# === Drive indexing ===
DRIVE_PAGE_SIZE=25
DRIVE_ALLOWED_MIME=* # "*" or comma list like: application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
FILE_MAX_SIZE_MB=8
DRIVE_ENABLE_TEXT_INDEX=false
DRIVE_INDEX_CRON=*/30 * * * *
DRIVE_MAX_CONCURRENCY=3
DRIVE_LIST_TTL_SEC=60
DRIVE_TEXT_TTL_SEC=21600
DRIVE_OWNER_ALLOWLIST=
DRIVE_HIDE_WEBLINK=true

# === AI ===
AI_PROVIDER=openai # openai|ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# === RAG / Search ===
RETRIEVER_K=6
RETRIEVER_ALPHA=0.5
EMBEDDINGS_ENABLE=false
EMBEDDINGS_PROVIDER=mock # openai|mock
EMBEDDINGS_MODEL=text-embedding-3-small
RAG_MAX_CONTEXT_TOKENS=1200
AI_MAX_TOKENS=512
SEARCH_INDEX_PATH=workspace/search.sqlite
SEARCH_FTS_TOKENIZER=unicode61
SEARCH_BATCH_SIZE=50

# Drive Q&A limits
# Max tokens for the model's answer (overrides AI_MAX_TOKENS if set)
DRIVE_QA_MAX_TOKENS=512
# Max number of characters to include from exported Drive context
DRIVE_QA_MAX_CONTEXT_CHARS=4000

# === Redis ===
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_URL=

# === Metrics ===
METRICS_ENABLED=true
METRICS_PORT=9091
METRICS_PATH=/metrics

# === Security & Performance ===
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=30
ADMIN_ROLE=admin
BOT_USER_ROLE=bot
CACHE_TTL=300
MAX_SEARCH_RESULTS=50
MAX_ANALYSIS_ROWS=1000
REQUEST_TIMEOUT=30000
MAX_RETRIES=3

# Component ID signing (HMAC + TTL)
# IMPORTANT: Set a strong key in production (>=16 chars). Rotate periodically.
COMPONENT_HMAC_KEY=change_me_please_min16chars
# TTL in milliseconds for signed component IDs (e.g., 10 minutes = 600000)
COMPONENT_TTL_MS=900000

# Security policy (files and PII)
# Comma-separated or JSON array of allowed MIME types
SECURITY_MIME_ALLOWLIST=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
# Max file size in bytes (default 25MB)
SECURITY_MAX_BYTES=26214400
# PII masking flags
SECURITY_PII_MASTER=true
SECURITY_PII_EMAIL=true
SECURITY_PII_PHONE=true

# === Logging ===
LOG_LEVEL=info
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m
LOG_DIRECTORY=logs

# === Dev helpers ===
# Allow stub Google keys for local smoke-run (with warnings)
ALLOW_GOOGLE_STUBS=false
