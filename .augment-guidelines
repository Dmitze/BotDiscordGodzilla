# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-app-client-id
DISCORD_GUILD_ID=your-dev-guild-id
DISCORD_PREFIX=/

# Google
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_API_KEY=unused-or-empty
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-sa.json
GOOGLE_APP_SCRIPT_URL=
GOOGLE_SHEET_NAME=Аркуш1

# Redis
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_URL=

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9100
METRICS_PATH=/metrics

# Security
SECURITY_RATE_LIMIT_WINDOW=60000
SECURITY_RATE_LIMIT_MAX=60
SECURITY_ADMIN_ROLE=Admin
SECURITY_BOT_USER_ROLE=BotUser

# Performance
PERF_CACHE_TTL=60
PERF_MAX_SEARCH_RESULTS=200
PERF_MAX_ANALYSIS_ROWS=5000
PERF_REQUEST_TIMEOUT=15000
PERF_MAX_RETRIES=3

# Logging
LOG_LEVEL=info
LOG_MAX_FILES=10
LOG_MAX_SIZE=10m
LOG_DIRECTORY=./data/logs
