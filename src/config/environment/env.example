# ========================================
# DISCORD AI BOT - ЗМІННІ СЕРЕДОВИЩА
# ========================================

# === DISCORD НАЛАШТУВАННЯ ===
# Токен вашого Discord бота
DISCORD_TOKEN=your_discord_bot_token_here

# ID клієнта Discord додатку
DISCORD_CLIENT_ID=your_discord_client_id_here

# ID сервера (Guild) для реєстрації команд
DISCORD_GUILD_ID=your_guild_id_here

# Префікс команд (за замовчуванням)
BOT_PREFIX=!

# === GOOGLE СЕРВІСИ ===
# ID Google Spreadsheet
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ID папки Google Drive для роботи з файлами
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# API ключ Google (для Google Sheets)
GOOGLE_API_KEY=your_google_api_key_here

# Шлях до файлу облікових даних Google Service Account
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# URL Google Apps Script (якщо використовується)
APP_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec

# Назва аркуша в таблиці
SHEET_NAME=Аркуш1

# === AI НАЛАШТУВАННЯ ===
# Провайдер AI (openai або ollama)
AI_PROVIDER=openai

# OpenAI налаштування
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Ollama налаштування (якщо використовується)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# === REDIS КЕШУВАННЯ ===
# Увімкнути Redis (true/false)
REDIS_ENABLED=false

# Redis налаштування
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === БЕЗПЕКА ===
# Увімкнути rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Rate limiting налаштування
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Ролі Discord для доступу
ADMIN_ROLE=Адміністратор
BOT_USER_ROLE=Бот-Користувач
SHEETS_ACCESS_ROLE=Sheets-Доступ
AI_ACCESS_ROLE=AI-Доступ
EXPORT_ACCESS_ROLE=Експорт-Доступ

# Рівень логування безпеки
SECURITY_LOG_LEVEL=info

# === ФАЙЛИ ТА ЕКСПОРТ ===
# Максимальний розмір файлу (в байтах)
MAX_FILE_SIZE=10485760

# Максимальний розмір файлу для експорту
EXPORT_MAX_FILE_SIZE=26214400

# Тимчасова папка
TEMP_DIR=./tmp

# Інтервал очищення тимчасових файлів (в мс)
FILE_CLEANUP_INTERVAL=3600000

# Таймаут завантаження файлів (в мс)
DOWNLOAD_TIMEOUT=30000

# TTL тимчасових файлів (в мс)
TEMP_FILE_TTL=60000

# Включити метадані в експорт
INCLUDE_METADATA=true

# === ПРОДУКТИВНІСТЬ ===
# TTL кешу (в мс)
CACHE_TTL=300000

# Максимальна кількість результатів пошуку
MAX_SEARCH_RESULTS=20

# Максимальна кількість рядків для аналізу
MAX_ANALYSIS_ROWS=50

# Таймаут запитів (в мс)
REQUEST_TIMEOUT=30000

# Максимальна кількість повторних спроб
MAX_RETRIES=3

# === ЛОГУВАННЯ ===
# Рівень логування
LOG_LEVEL=info

# Максимальна кількість файлів логів
LOG_MAX_FILES=5

# Максимальний розмір файлу логу
LOG_MAX_SIZE=10m

# === МЕТРИКИ ===
# Увімкнути метрики Prometheus
METRICS_ENABLED=true

# Порт для метрик
PROMETHEUS_PORT=9090

# Шлях до метрик
METRICS_PATH=/metrics

# === СЕРЕДОВИЩЕ ===
# Середовище розробки
NODE_ENV=development

# === БЕЗПЕКА КОМПОНЕНТІВ (Discord customId підпис) ===
# Секретний ключ для HMAC підпису компонентів (мінімум 16 символів)
COMPONENT_HMAC_KEY=change_me_please_min16chars
# TTL підписаних компонентів у мілісекундах (наприклад, 15 хвилин)
COMPONENT_TTL_MS=900000

# === ПОШУК / ІНДЕКСАЦІЯ (SQLite FTS) ===
# Шлях до файлу індексу пошуку
SEARCH_INDEX_PATH=./data/search-index.db
# Розмір батчу індексації (кількість документів за одну транзакцію)
SEARCH_BATCH_SIZE=50
# Опціонально: токенайзер для FTS5 (якщо використовується спеціальний збір SQLite)
# SEARCH_FTS_TOKENIZER=unicode61

# === RAG / ГІБРИДНИЙ РЕТРІВЕР ===
# Скільки топ-документів повертати
RETRIEVER_K=8
# Вага FTS у гібридному скорингу [0..1], 1 = лише FTS, 0 = лише ембеддинги
RETRIEVER_ALPHA=0.6
# Максимальна кількість токенів контексту, переданого в модель
RAG_MAX_CONTEXT_TOKENS=1200
# Максимальна кількість токенів відповіді моделі
AI_MAX_TOKENS=800

# === ЕМБЕДДИНГИ ===
# Провайдер ембеддингів: openai або mock (детермінований)
EMBEDDINGS_PROVIDER=mock
# Модель ембеддингів для OpenAI
EMBEDDINGS_MODEL=text-embedding-3-small